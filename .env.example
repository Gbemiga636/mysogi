# Required
GROQ_API_KEY=
OPENAI_API_KEY=

# Flyer: AI = marketing only; exact Step 1 phone/email/website burned on bottom via Sharp
# Creative Agency pipeline (Trial-4 quality) — expands short prompts before image model
MYSOGI_CREATIVE_AGENCY=true
FLYER_FINISHED_DESIGN=true
FLYER_AD_BRAIN=true
FLYER_WORLD_CLASS=true
# OpenAI image — use high quality for agency layouts (gpt-image-1)
FLYER_IMAGE_PROVIDER=openai
FLYER_OPENAI_MODEL=gpt-image-1
FLYER_OPENAI_QUALITY=high
FLYER_EXACT_CONTACT_FOOTER=true
FLYER_EXACT_CONTACT_IN_AI=false
# Sharp SVG footer (default). Set true only to use Cloudinary text instead.
FLYER_CLOUDINARY_FOOTER=false
FLYER_LOGO_COMPOSE=sharp
FLYER_TEXT_MODE=hybrid
FLYER_PREMIUM_HYBRID=false
ELITE_CREATIVE_ENGINE=true

# Required for Cloudinary footer + CDN uploads
CLOUDINARY_URL=

# Optional
REPLICATE_API_TOKEN=
FFMPEG_PATH=

# Vercel production — Redis/KV for async job polling
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
