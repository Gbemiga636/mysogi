# Groq Cloud — scripts, captions, prompts

GROQ_API_KEY=your_groq_api_key_here



# Replicate — google/imagen-4 (flyers) + minimax/video-01 (video)

REPLICATE_API_TOKEN=your_replicate_api_token_here



# Flyer background image provider (instant switch — restart dev server after change)

# replicate = Google Imagen 4 via Replicate (default)

# openai = DALL·E 3 direct (~$0.04 per 1024×1024 standard, no retries)

# FLYER_IMAGE_PROVIDER=replicate

# OPENAI_API_KEY=your_openai_api_key

# FLYER_OPENAI_MODEL=gpt-image-1

# FLYER_OPENAI_API_FAMILY=gpt

# FLYER_OPENAI_QUALITY=medium

# FLYER_OPENAI_FORCE_SQUARE=true

# false (default): copy typeset inside AI image; small logo at top center. true: scene + SVG text
# FLYER_PREMIUM_HYBRID=false

# true = senior designer: complete ad in image (typography + layout + CTA). Set hybrid false first.
# FLYER_FINISHED_DESIGN=true

# false = use overlay typography when hybrid is off
# FLYER_FINISHED_DESIGN=false

# Legacy DALL·E 3 only if your OpenAI account still supports style/response_format:

# FLYER_OPENAI_MODEL=dall-e-3

# FLYER_OPENAI_API_FAMILY=dalle

# FLYER_OPENAI_QUALITY=standard



# Flyer text mode (default: hybrid)

# hybrid = cinematic text-free Imagen + pixel-perfect Sharp/Cloudinary copy (recommended)

# ai = Imagen renders copy in-image (less accurate spelling)

# overlay = legacy text-free plate + compose

# FLYER_TEXT_MODE=hybrid



# Logo after flyer: cloudinary (default if CLOUDINARY_URL set) or sharp

# FLYER_LOGO_COMPOSE=cloudinary



# Legacy full compose engine (hybrid/overlay modes): sharp, hybrid, cloudinary

# FLYER_COMPOSE_ENGINE=hybrid



# Cloudinary — logo overlay + Polish editor (required for logo compose when configured)

# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# CLOUDINARY_CLOUD_NAME=your_cloud_name_from_dashboard

# CLOUDINARY_API_KEY=your_api_key

# CLOUDINARY_API_SECRET=your_api_secret

# CLOUDINARY_UPLOAD_PRESET=mysogi_unsigned



# Optional: path to ffmpeg binary (leave empty to use system PATH)

# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

